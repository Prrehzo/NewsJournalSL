rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // School Logos: Allow unauthenticated read/write (for registration)
    match /schools/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Everything else (admins, articles, etc): Authenticated access only
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null 
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
