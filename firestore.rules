rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isSuperAdmin() {
      let role = getUserData().role;
      return isSignedIn() && (role == 'super_admin' || role == 'admin' || role == 'Super Administrator');
    }
    
    function isSchoolAdmin(schoolId) {
      let role = getUserData().role;
      return isSignedIn() && (role == 'school_admin' || role == 'School Admin') && getUserData().schoolId == schoolId;
    }

    // Collection Group Queries
    match /{path=**}/reactions/{reactionId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Users Collection
    match /users/{userId} {
      // Allow users to read their own profile
      // Allow school admins to read reporters in their school
      // Allow super admins to read/write any profile
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isSuperAdmin() ||
        ((getUserData().role == 'school_admin' || getUserData().role == 'School Admin') && getUserData().schoolId == resource.data.schoolId) ||
        // Allow migration logic to search by email (queried by public/authenticated users during login)
        (request.query != null && request.query.limit <= 1)
      );
      allow create: if isSignedIn(); // Allow initial signup
      allow update: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow delete: if isSuperAdmin() || (isSchoolAdmin(resource.data.schoolId) && resource.data.role == 'reporter');
    }
    
    // Schools Collection
    match /schools/{schoolId} {
      allow read: if true; // Public can see schools
      allow create: if true; // Public can apply
      allow update: if isSuperAdmin() || isSchoolAdmin(schoolId);
      allow delete: if isSuperAdmin();
    }
    
    // Articles Collection
    match /articles/{articleId} {
      function isReactionUpdate() {
        let authOk = request.auth != null;
        let keysOk = request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'dislikeCount']);
        
        let newLike = request.resource.data.likeCount != null ? request.resource.data.likeCount : 0;
        let oldLike = resource.data.likeCount != null ? resource.data.likeCount : 0;
        let newDislike = request.resource.data.dislikeCount != null ? request.resource.data.dislikeCount : 0;
        let oldDislike = resource.data.dislikeCount != null ? resource.data.dislikeCount : 0;
        
        let rxPath = authOk ? /databases/$(database)/documents/articles/$(articleId)/reactions/$(request.auth.uid) : /databases/$(database)/documents/articles/$(articleId)/reactions/invalid;
        let rxExists = authOk ? existsAfter(rxPath) : false;
        let rxType = rxExists ? getAfter(rxPath).data.type : '';

        return authOk && keysOk && newLike >= 0 && newDislike >= 0 && (
          ((newLike - oldLike) == 1 && (newDislike - oldDislike) == 0 && rxExists && rxType == 'like') ||
          ((newLike - oldLike) == 0 && (newDislike - oldDislike) == 1 && rxExists && rxType == 'dislike') ||
          ((newLike - oldLike) == -1 && (newDislike - oldDislike) == 0 && !rxExists) ||
          ((newLike - oldLike) == 0 && (newDislike - oldDislike) == -1 && !rxExists) ||
          ((newLike - oldLike) == 1 && (newDislike - oldDislike) == -1 && rxExists && rxType == 'like') ||
          ((newLike - oldLike) == -1 && (newDislike - oldDislike) == 1 && rxExists && rxType == 'dislike')
        );
      }

      allow read: if true; // Public can read articles
      allow create: if isSignedIn() && (getUserData().role in ['school_admin', 'School Admin', 'reporter']);
      allow update: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolAdmin(resource.data.schoolId) || 
        request.auth.uid == resource.data.authorId ||
        isReactionUpdate()
      );
      allow delete: if isSignedIn() && (
        isSuperAdmin() || 
        isSchoolAdmin(resource.data.schoolId) || 
        request.auth.uid == resource.data.authorId
      );

      match /reactions/{userId} {
        allow read: if true;
        allow delete: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.articleId == articleId &&
          request.resource.data.type in ['like', 'dislike'] &&
          request.resource.data.keys().hasOnly(['userId', 'articleId', 'type', 'createdAt', 'updatedAt']);
      }
      
      match /comments/{commentId} {
        function isArticleSchoolPremium() {
          let article = get(/databases/$(database)/documents/articles/$(articleId)).data;
          let school = get(/databases/$(database)/documents/schools/$(article.schoolId)).data;
          return school.plan == 'premium';
        }
        
        allow read: if true;
        allow create: if isSignedIn() && 
          request.auth.token.email_verified == true &&
          isArticleSchoolPremium() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.articleId == articleId &&
          request.resource.data.text is string &&
          request.resource.data.text.trim().size() > 0 &&
          request.resource.data.keys().hasOnly(['userId', 'articleId', 'text', 'displayName', 'createdAt', 'updatedAt']);
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isSuperAdmin());
      }
    }
    
    // Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
    
    // Settings Collection
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
    
    // Admin Requests (Setup)
    match /admin_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }
    
    // Newsletter Subscriptions
    match /subscriptions/{subId} {
      allow create: if true;
      allow read, delete: if isSuperAdmin();
    }
  }
}
